          "namespace"
        ]
      },
      "person": {
        "refused": [],
        "required": [
          "aggregateId",
          "namespace"
        ]
      }
    },
    "heartbeatNode": {
      "inputType": "HeartbeatNodeInput",
      "machine": {
        "refused": [],
        "required": [
          "aggregateId",
          "namespace"
        ]
      },
      "person": {
        "refused": [],
        "required": [
          "aggregateId",
          "namespace"
        ]
      }
    },
    "registerNode": {
      "inputType": "RegisterNodeInput",
      "machine": {
